---
import '../styles/global.css';
import { RESUME_URL, EMAIL, FOOTER_SOCIALS } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  light?: boolean;
  active?: 'case' | 'works' | 'about';
}
const {
  title = 'Ghoniyyu Maulidi, UI/UX Designer',
  description = 'A versatile designer with 9+ years, turning complex systems into experiences that feel simple and human.',
  light = false,
  active,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class={light ? 'light' : ''} id="top">
    <header class="site-header">
      <a href="/" class="logo">Ghoniyyu Maulidi</a>
      <button class="menu-btn" aria-label="Open menu" aria-expanded="false" data-menu>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
      <nav class="nav" aria-label="Main" data-nav>
        <a href="/case" aria-current={active === 'case' ? 'page' : undefined}>Selected Case</a>
        <a href="/works" aria-current={active === 'works' ? 'page' : undefined}>Works</a>
        <a href="/about" aria-current={active === 'about' ? 'page' : undefined}>About</a>
        <a href={RESUME_URL} target="_blank" rel="noopener">Resume</a>
        <a class="btn" href={`mailto:${EMAIL}`}>Let's talk</a>
      </nav>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Ghoniyyu Maulidi · Jakarta, Indonesia</span>
      <nav aria-label="Social" class="footer-social">
        {FOOTER_SOCIALS.map((s) => <a href={s.url} target="_blank" rel="noopener">{s.name}</a>)}
      </nav>
    </footer>

    <a href="#top" class="to-top" aria-label="Back to top" data-top>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 7-7 7 7" /><path d="M12 19V5" /></svg>
    </a>

    <script>
      // Mobile menu
      const btn = document.querySelector<HTMLButtonElement>('[data-menu]');
      const nav = document.querySelector('[data-nav]');
      btn?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(!!open));
      });

      // Back to top appears after scrolling one screen
      const top = document.querySelector('[data-top]');
      const onScroll = () => top?.classList.toggle('show', window.scrollY > window.innerHeight);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Reveal (fade up) and grow (small to full size) as elements enter the screen
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
        { threshold: 0.12 }
      );
      const watch = () => document.querySelectorAll('.reveal:not(.in), .grow:not(.in)').forEach((el) => io.observe(el));
      watch();
      document.addEventListener('works:filtered', watch);
    </script>
  </body>
</html>
